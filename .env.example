# Общий PIN Photo Sorter: ровно 5 цифр. Реальный .env НЕ коммитить.
PHOTO_SORTER_PASSWORD=12345

# Отдельный пароль только для загрузки папки фотографий и административной настройки корня.
PHOTO_SORTER_UPLOAD_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_UPLOAD_PASSWORD

# Случайная строка минимум 32 символа. На VDS удобно получить: openssl rand -hex 32
PHOTO_SORTER_SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARACTERS

# За Nginx Proxy Manager + HTTPS оставляем 1.
PHOTO_SORTER_COOKIE_SECURE=1
PHOTO_SORTER_SESSION_HOURS=168

# Имя Docker-сети, в которой уже находится Nginx Proxy Manager.
# Узнать: docker network ls
NPM_NETWORK=nginx-proxy-manager_default

# Постоянные каталоги на VDS. Можно оставить относительными к папке репозитория.
PHOTO_STORAGE_PATH=./storage
PHOTO_DATA_PATH=./runtime/data
PHOTO_CACHE_PATH=./runtime/cache

# 8 MiB chunk и до 300 MiB на одну фотографию.
PHOTO_SORTER_MAX_UPLOAD_CHUNK_BYTES=8388608
PHOTO_SORTER_MAX_UPLOAD_FILE_BYTES=314572800
